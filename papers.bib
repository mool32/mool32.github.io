@software{spiro2026perceptome,
  abbr     = {toolkit},
  title    = {perceptome: a Python toolkit for cellular perception analysis},
  author   = {Spiro, Theodor},
  year     = {2026},
  version  = {0.2.2},
  doi      = {10.5281/zenodo.20113468},
  url      = {https://doi.org/10.5281/zenodo.20113468},
  code     = {https://github.com/mool32/perceptome},
  abstract = {A Python toolkit treating 44 cellular signaling pathways (NF-kB, mTOR, UPR, p53, nuclear receptors, ...) as a cell's perceptual repertoire. Three capabilities other tools don't directly provide: (1) a 9-PC eigenspace derived from 154 normal human cell types (Human Protein Atlas) where any cell can be located on the same map; (2) a capacity-floor predictor that says whether a cell type and pathway will ramp under stimulus or is already saturated; (3) a validity scorecard with three null controls (random-gene panel, housekeeping, cell cycle) that catches common perturbation artifacts before interpretation. The framework underpins the cancer-convergence result reported separately (Zenodo 10.5281/zenodo.20542130): malignant cells of 25 cancers converge on the placental cytotrophoblast, a normal invasive cell state that malignancy deepens within patients. The tool implements only what the underlying multi-year pre-registered research program validated and deliberately excludes operations that were tested and falsified.},
  teaser   = {A Python toolkit treating 44 cellular signaling pathways (NF-κB, mTOR, UPR, p53, nuclear receptors, …) as a cell's perceptual repertoire. Three capabilities other tools don't directly provide: (1) a 9-PC eigenspace derived from 154 normal human cell types (Human Protein Atlas) where any cell — yours, a tumor, a drug-treated — can be located on the same map; (2) a capacity-floor predictor — given a cell type and a pathway, will it ramp under stimulus or is it already saturated; (3) a validity scorecard with three null controls (random-gene panel, housekeeping, cell cycle) that catches common perturbation artifacts before interpretation. It is the toolkit behind the cancer-convergence finding — 25 cancers converge on the placental cytotrophoblast (Zenodo 10.5281/zenodo.20542130) — and implements only what that multi-year pre-registered program validated, deliberately excluding operations that were tested and falsified.},
  selected = {true},
  bibtex_show = {true},
  order    = {1},
  venue    = {Software release (v0.2.2)},
  stage    = {software-release},
  status   = {public release v0.2.2 (May 2026)}
}


@software{spiro2026metricautopsy,
  abbr     = {toolkit},
  title    = {metric-autopsy: a metric-agnostic gate system for separating biological signal from QC and technical artifacts in single-cell metrics},
  author   = {Spiro, Theodor},
  year     = {2026},
  version  = {0.1.1},
  doi      = {10.5281/zenodo.21195679},
  url      = {https://doi.org/10.5281/zenodo.21195679},
  code     = {https://github.com/mool32/metric-autopsy},
  abstract = {A metric that changes between conditions is not yet a finding: it may be dropout, library size, a batch effect, a factorial-interaction confound, or an artifact of the mathematics. metric-autopsy inverts the default from compute-then-believe to state-your-commitments, red-team, then believe. A computed single-cell metric is passed through eight gates -- mathematical independence under simulated dropout, factorial QC parity, n_genes matching, raw-data visibility, stratified controls, and cross-dataset replication, plus two judgment gates the tool elicits rather than scripts -- and the run stops at the first blocking failure. The metric is a black box: the caller supplies metric(data) -> float and the factorial obs columns, and the gates probe the data and the metric's response to controlled perturbations. The system was built from three of the author's own real failures (an entropy anticorrelation that reversed at low sequencing depth, a cardiac exponent that was conduction geometry rather than biology, and a SMAD-ECM mutual information driven by a detection-rate confound inside a sex-by-age interaction), each of which survived weeks of work before a short QC check killed it. On the worked example the reference metric fails 0 of N gates while a library-normalized reference passes, showing the confound is avoidable rather than universal. Honest limit: passing all eight gates removes only the artifacts these gates know about. Ships as a pip package, a Claude Code skill, and an MCP server; 35 tests.},
  teaser   = {Red-team a computed single-cell metric before you believe it. Eight gates — dropout independence, factorial QC parity, n_genes matching, stratified controls, cross-dataset replication — probe a black-box metric and stop at the first blocking failure. Built from three of my own failures that each survived weeks before a 45-second QC check killed them. Ships as a pip package, a Claude Code skill, and an MCP server; 35 tests.},
  selected = {true},
  bibtex_show = {true},
  order    = {2},
  venue    = {Software release (v0.1.1)},
  stage    = {software-release},
  status   = {public release v0.1.1 (Jul 2026)}
}

@misc{spiro2026cytotrophoblast,
  abbr     = {preprint},
  title    = {Cancers of all lineages converge on the placental cytotrophoblast, a normal invasive cell state that malignancy deepens},
  author   = {Spiro, Theodor},
  year     = {2026},
  howpublished = {Preprint (Zenodo)},
  doi      = {10.5281/zenodo.20542130},
  url      = {https://doi.org/10.5281/zenodo.20542130},
  abstract = {A coordinate system for cellular state is built from 44 transcriptional modules scored across 154 normal human cell types (Human Protein Atlas), using single-cell RNA exclusively and no cancer data; the resulting nine-dimensional eigenspace recovers known biology before any cancer is introduced. Projecting 25 quality-controlled single-cell cancer datasets, the malignant compartment of every major lineage converges onto one small region of normal-cell physiology, contracting the program space 6.3-fold relative to the cancers' near-orthogonal tissues of origin. A recurrence-and-depth ranking identifies a two-cell core: the placental cytotrophoblast -- the complexity-robust, lineage-independent anchor and the normal cell that physiologically invades, proliferates, and evades immunity -- with the megakaryocyte a lineage-restricted secondary. The state is not unique to cancer: some normal secretory epithelia (healthy lung) occupy it as fully as tumors. What is specifically malignant emerges within patients -- in matched tumor-normal pairs, malignant epithelium converges about sixfold deeper than the patient's own normal tissue (colorectal 43/46 patients, paired P < 1e-12; replicated in kidney and liver, 77/86 patients; absent in the one high-baseline tissue, lung). Cancer thus reaches a pre-existing, tissue-variable normal cell state and deepens it, linking malignancy quantitatively and geometrically to normal placental and developmental biology rather than to a uniquely cancerous program.},
  teaser   = {A coordinate map built from 44 signaling modules over 154 normal cell types — no cancer data — onto which the malignant cells of 25 cancers converge. The anchor is the placental cytotrophoblast, a normal cell state that naturally invades, proliferates, and evades immunity; within patients, malignancy deepens the state ~6× over matched normal tissue (colorectal 43/46, paired P < 10⁻¹²). Not a uniquely cancerous program but a normal placental/developmental one, pushed deeper.},
  bibtex_show = {true},
  order    = {0},
  venue    = {Preprint (Zenodo)},
  stage    = {preprint},
  selected = {true},
  headline = {true},
  status   = {preprint on Zenodo (DOI 10.5281/zenodo.20542130)}
}


@misc{spiro2026memory,
  abbr     = {preprint},
  title    = {Cellular proteostasis modules causally enable memory consolidation through region-specific architectures},
  author   = {Spiro, Theodor},
  year     = {2026},
  howpublished = {Manuscript, submission-ready},
  code     = {https://mool32.github.io/memory-consolidation/},
  abstract = {Memory consolidation requires coordinated signaling and proteostatic remodeling, but their integration at the module level has been unmapped. Reading 44 cellular sensing modules (the perceptome framework) across seven transcriptomic datasets, with 26 predictions registered before analysis and tested on two further sleep-perturbation datasets, resolves consolidation into a three-layer architecture: a perception layer (cAMP/CREB, ERK/FOS, NFAT, NPAS4) that senses the encoding trigger (transient, post-translational; CREB activity d=+0.80 at 24h, d=-0.19 by 96h); a sentinel sub-layer (UPR-ATF6, ATF4, PERK) that senses accumulated proteostatic load (persistent; UPR-ATF6 d=+1.04 at 96h, enriched in engram-like neurons); and a constructive sub-layer (HSF1, NRF2, autophagy, IRE1) that builds proteostatic machinery (HSF1 d=+1.40 at 24h, exceeding CREB). Implementations are region-specific: hippocampus induces ER and cytoplasmic chaperones plus autophagy (building new synapses), whereas amygdala suppresses cytoplasmic chaperones against a 1.8-fold higher baseline reserve (swapping receptors in existing synapses). TLR9 knockout selectively blunts ER-chaperone induction by 60-75% with cytoplasmic chaperones preserved, and impairs contextual fear memory -- direct causal evidence for one arm. Thirty-two published proteostasis-manipulation experiments yield the predicted memory direction in 28 cases with zero contradictions. A readiness-versus-activity scoring refinement captures post-translational activation missed by component scoring and validates cross-domain (Alzheimer neurons 0/8 sign reversals; aging tissues 9.4%). NPAS4 is proposed as a 44th, tissue-restricted canonical module; chemical chaperones offer a falsifiable therapeutic prediction.},
  teaser   = {Memory consolidation, read through 44 cellular sensing modules, resolves into a three-layer architecture — perception (senses the trigger), sentinel (senses proteostatic load), and construction (builds the machinery) — that separates cleanly in time and mechanism. TLR9 knockout selectively removes the ER-chaperone arm (−60–75%) and impairs memory: direct causal evidence. 26 pre-registered predictions across 7 datasets; 28/32 published perturbations predicted correctly, 0 contradictions.},
  bibtex_show = {true},
  order    = {1},
  venue    = {Manuscript, submission-ready},
  stage    = {submission-ready},
  selected = {true},
  status   = {manuscript submission-ready; results page live, preprint in preparation}
}


